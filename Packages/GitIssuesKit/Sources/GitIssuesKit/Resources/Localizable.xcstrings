      "comment" : "Mac: tooltip of the 'Add Priority field' button. Priority, Urgent, High, Medium and Low are the names the field and its options get on GitHub, in English.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This project has no Priority field. Add one with Urgent, High, Medium and Low."
