{
  "sourceLanguage" : "en",
  "strings" : {
    "account" : {
      "comment" : "Mac sidebar, top: VoiceOver label of the button with the signed-in user's avatar and GitHub login, which opens the account menu.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Account"
          }
        }
      }
    },
    "addColumn" : {
      "comment" : "Mac board: button after the last column that adds a new column (a new status of the GitHub project).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add column"
          }
        }
      }
    },
    "addLabelsCommand" : {
      "comment" : "Mac, command palette (⌘K): command that opens the list of the repository's GitHub labels to add to the issue.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add labels…"
          }
        }
      }
    },
    "addPriorityField" : {
      "comment" : "Mac: button at the top of a GitHub project that has no priority field; creates one in the project. 'Priority' is the name the field gets on GitHub, in English.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add Priority field"
          }
        }
      }
    },
    "addPriorityFieldTooltip" : {
      "comment" : "Mac: tooltip of the 'Add Priority field' button. Priority, Urgent, High, Medium and Low are the names the field and its options get on GitHub, in English.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This project has no Priority field. Add one with Urgent, High, Medium and Low."
          }
        }
      }
    },
    "addSubIssueCommand" : {
      "comment" : "Mac, command palette (⌘K): command for writing a new issue under the issue in focus. 'Sub-issue' is the GitHub term.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add sub-issue"
