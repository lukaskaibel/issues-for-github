    "usualOrderExplanation" : {
      "comment" : "iPhone and iPad, Arrange Sections sheet: note under 'Back to the Usual Order' describing that order of the status groups.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuerst, was in Arbeit ist, dann, was als Nächstes kommt, dann Backlog und Erledigtes."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Work in progress first, then what's next, the backlog and what's done."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero lo que está en curso, luego lo siguiente, el backlog y lo hecho."
