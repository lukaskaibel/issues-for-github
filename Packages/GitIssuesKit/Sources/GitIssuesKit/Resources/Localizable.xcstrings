        }
      }
    },
    "addToProjectCommand" : {
      "comment" : "Mac, command palette (⌘K): command for an issue that is on no GitHub project board; opens a list of the projects' statuses to put it in.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add to project…"
