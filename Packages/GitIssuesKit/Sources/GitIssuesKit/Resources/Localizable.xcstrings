    "issueDeletionMessage" : {
      "comment" : "Mac: message of the alert before deleting an issue. %(title)@ is the issue's title. Also: iPhone and iPad: message of the alert that asks before deleting an issue. %(title)@ is the issue's title.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Issue „%@“ und seine Kommentare werden auf GitHub für alle gelöscht. Dies kann nicht widerrufen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%(title)@” and its comments are deleted on GitHub for everyone. This can't be undone."
