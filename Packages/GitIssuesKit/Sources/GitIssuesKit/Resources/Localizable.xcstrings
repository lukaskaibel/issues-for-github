    "statusEditorFooter" : {
      "comment" : "iPhone and iPad, Statuses screen of a project: note under the list of statuses. 'Status' is the name of the field on GitHub (GitHub is in English); a GitHub project is a board.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das sind die Werte des Felds „Status“ im Projekt auf GitHub – und die Spalten seines Boards. Änderungen werden sofort auf GitHub gespeichert und brauchen daher eine Verbindung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These are the project's Status field on GitHub and the columns of its board. Changes are saved on GitHub right away, so they need a connection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son los valores del campo “Status” del proyecto en GitHub y las columnas de su tablero. Los cambios se guardan en GitHub al momento, así que necesitan conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce sont les valeurs du champ Status du projet sur GitHub et les colonnes de son tableau. Les modifications sont enregistrées immédiatement sur GitHub et nécessitent donc une connexion."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらはGitHub上のプロジェクトの「Status」フィールドで、ボードの列でもあります。変更はすぐにGitHubに保存されるため、接続が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기 있는 상태는 GitHub 프로젝트의 Status 필드 값이자 보드의 열입니다. 변경 사항은 GitHub에 바로 저장되므로 인터넷 연결이 필요합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas são as opções do campo Status do projeto no GitHub e as colunas do quadro. As alterações são salvas no GitHub na hora, então é preciso estar conectado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это поле «Status» проекта на GitHub и колонки его доски. Изменения сразу сохраняются на GitHub, поэтому нужно подключение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些是项目在 GitHub 上的“Status”字段，也就是其看板的列。更改会立即保存到 GitHub，因此需要联网。"
          }
        }
      }
    },
