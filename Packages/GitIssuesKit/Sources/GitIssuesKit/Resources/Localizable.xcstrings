    "appVersionLoginNote" : {
      "comment" : "iPhone and iPad, account sheet: the app's name and version at the bottom, with a note on privacy. 'Issues' is the app's name; %(version)@ is its version, e.g. '1.2'. Keep api.github.com as it is.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Issues %@ · Deine Anmeldedaten werden im iCloud-Schlüsselbund gespeichert und nur an api.github.com gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Issues %(version)@ · Your login is kept in iCloud Keychain and only sent to api.github.com."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Issues %@ · Tu inicio de sesión se guarda en el Llavero de iCloud y solo se envía a api.github.com."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Issues %@ · Vos identifiants sont conservés dans le trousseau iCloud et envoyés uniquement à api.github.com."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Issues %@ · ログイン情報はiCloudキーチェーンに保存され、api.github.comにのみ送信されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Issues %@ · 로그인 정보는 iCloud 키체인에 보관되며 api.github.com으로만 전송됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Issues %@ · Seu login fica nas Chaves do iCloud e só é enviado para api.github.com."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Issues %@ · Данные для входа хранятся в Связке ключей iCloud и отправляются только на api.github.com."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Issues %@ · 你的登录信息保存在 iCloud 钥匙串中，仅会发送至 api.github.com。"
          }
        }
      }
    },
