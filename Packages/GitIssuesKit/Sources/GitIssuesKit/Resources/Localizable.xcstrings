    "shareLoginMessage" : {
      "comment" : "Mac: message of the alert offering to share the login with the iPhone and iPad. 'GitHub CLI' is GitHub's command-line tool.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Anmeldedaten der GitHub CLI können im iCloud-Schlüsselbund gespeichert werden, damit sich die App auf deinem iPhone und iPad von selbst anmeldet. Du kannst das später in den Einstellungen ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your GitHub CLI login can be kept in iCloud Keychain, so the app on your iPhone and iPad signs in by itself. You can change this later in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu inicio de sesión de GitHub CLI puede guardarse en el Llavero de iCloud para que la app de tu iPhone y iPad inicie sesión sola. Puedes cambiarlo más tarde en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos identifiants GitHub CLI peuvent être conservés dans le trousseau iCloud, pour que l’app se connecte d’elle-même sur votre iPhone et votre iPad. Vous pourrez modifier ce choix plus tard dans les réglages."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub CLIのログイン情報をiCloudキーチェーンに保存すると、iPhoneとiPadのAppが自動的にサインインします。この設定はあとから「設定」で変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub CLI 로그인 정보를 iCloud 키체인에 보관하면 iPhone 및 iPad의 앱이 자동으로 로그인됩니다. 나중에 설정에서 변경할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu login da GitHub CLI pode ficar nas Chaves do iCloud para que o app no seu iPhone e iPad inicie sessão sozinho. Você pode mudar isso depois nos Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данные для входа из GitHub CLI можно сохранить в Связке ключей iCloud, чтобы приложение на iPhone и iPad входило само. Это можно изменить позже в Настройках."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 GitHub CLI 登录信息可以保存在 iCloud 钥匙串中，这样你的 iPhone 和 iPad 上的 App 就能自动登录。你稍后可以在“设置”中更改。"
          }
        }
      }
    },
