    "appIconFootnote" : {
      "comment" : "Mac Settings: note under the choice of app icons. 'The first' is the card on its light page, the app's own icon.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle passen sich dem hellen und dunklen Erscheinungsbild an. Das erste ist das eigene Symbol der App, die anderen erscheinen im Dock, solange die App geöffnet ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All follow light and dark mode. The first is the app's own icon; the others show in the Dock while the app is open."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos siguen el modo claro u oscuro. El primero es el icono propio de la app; los demás se muestran en el Dock mientras la app está abierta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes suivent le mode clair ou sombre. La première est l’icône propre à l’app ; les autres s’affichent dans le Dock tant que l’app est ouverte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのアイコンはライトモードとダークモードに合わせて切り替わります。最初のアイコンはApp本来のアイコンで、その他のアイコンはAppが開いている間Dockに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 아이콘은 라이트 및 다크 모드를 따릅니다. 첫 번째 아이콘은 앱의 기본 아이콘이며, 다른 아이콘은 앱이 열려 있는 동안 Dock에 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos acompanham o modo claro e escuro. O primeiro é o ícone próprio do app; os outros aparecem no Dock enquanto o app está aberto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все значки меняются вместе со светлым и темным оформлением. Первый — собственный значок приложения, остальные видны в Dock, пока приложение открыто."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有图标都会随浅色和深色模式切换。第一个是 App 自带的图标；其他图标会在 App 打开时显示在程序坞中。"
          }
        }
      }
    },
