    "addPriorityField" : {
      "comment" : "iPhone and iPad: item in a project's '…' menu that adds a Priority field to the GitHub project. 'Field' is a GitHub project field (a column of data).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add Priority Field"
          }
        }
      }
    },
    "addPriorityFieldHint" : {
      "comment" : "iPhone and iPad: text of the banner under 'No Priority field'. Urgent, High, Medium and Low are the names the options get on GitHub, in English; keep them in English.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add one with Urgent, High, Medium and Low to sort by importance."
          }
        }
      }
    },
    "addPriorityFieldMac" : {
      "comment" : "Mac: button at the top of a GitHub project that has no priority field; creates one in the project. 'Priority' is the name the field gets on GitHub, in English.",
      "extractionState" : "manual",
