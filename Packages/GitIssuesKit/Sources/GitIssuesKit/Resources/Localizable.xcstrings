    "appIconFootnote" : {
      "comment" : "Mac Settings: note under the choice of app icons.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das erste passt sich dem hellen und dunklen Erscheinungsbild an. Die anderen erscheinen im Dock, solange die App geöffnet ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The first one follows light and dark mode. Others show in the Dock while the app is open."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El primero sigue el modo claro u oscuro. Los demás se muestran en el Dock mientras la app está abierta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La première suit le mode clair ou sombre. Les autres s’affichent dans le Dock tant que l’app est ouverte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初のアイコンはライトモードとダークモードに合わせて切り替わります。その他のアイコンは、Appが開いている間Dockに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "첫 번째 아이콘은 라이트 및 다크 모드를 따릅니다. 다른 아이콘은 앱이 열려 있는 동안 Dock에 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O primeiro acompanha o modo claro e escuro. Os outros aparecem no Dock enquanto o app está aberto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Первый значок меняется вместе со светлым и темным оформлением. Остальные видны в Dock, пока приложение открыто."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第一个图标会随浅色和深色模式切换。其他图标会在 App 打开时显示在程序坞中。"
          }
        }
      }
    },
