    "gitHubCLINotSignedIn" : {
      "comment" : "Mac sign-in screen: error after 'Use my GitHub CLI login' when GitHub's command-line tool has no login. 'gh auth login' is a command; keep it as is. Terminal is the Mac app.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die GitHub CLI ist nicht angemeldet. Führe „gh auth login“ im Terminal aus und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The GitHub CLI isn't signed in. Run “gh auth login” in Terminal, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub CLI no tiene ninguna sesión iniciada. Ejecuta “gh auth login” en Terminal y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub CLI n’est pas connecté. Exécutez « gh auth login » dans Terminal, puis réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub CLIにサインインしていません。ターミナルで「gh auth login」を実行してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub CLI에 로그인되어 있지 않습니다. 터미널에서 “gh auth login”을 실행한 다음 다시 시도하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
