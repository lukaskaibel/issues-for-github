    "projectEmptyMessage" : {
      "comment" : "Mac: message under the title of a GitHub project's empty list. C is the key for a new issue; keep it.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücke C, um das erste zu erstellen. Hier erscheinen nur Issues, die in diesem GitHub-Projekt sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press C to create the first one. Only issues that are in this GitHub Project appear here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa C para crear la primera. Aquí solo aparecen las incidencias que están en este proyecto de GitHub."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur C pour créer le premier. Seuls les tickets de ce projet GitHub apparaissent ici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cを押すと最初のIssueを作成できます。このGitHubプロジェクトにあるIssueだけがここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C 키를 눌러 첫 번째 이슈를 생성하세요. 이 GitHub 프로젝트에 있는 이슈만 여기에 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressione C para criar a primeira. Só aparecem aqui as issues que estão neste projeto do GitHub."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите C, чтобы создать первую задачу. Здесь показываются только задачи из этого проекта GitHub."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按 C 创建第一个议题。只有此 GitHub 项目中的议题才会显示在这里。"
          }
        }
      }
    },
    "projectGoneMessage" : {
      "comment" : "iPhone and iPad: explanation under 'This project is gone'.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wurde geschlossen oder gelöscht, oder du hast auf GitHub keinen Zugriff mehr darauf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It was closed, deleted, or you no longer have access to it on GitHub."
          }
