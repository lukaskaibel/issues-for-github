    "projectIconNote" : {
      "comment" : "Note under the picker of a project's glyph and colour (Mac dropdown, iPhone and iPad sheet): the icon is kept by the app in the user's iCloud, not on GitHub, so teammates don't see it.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
