    "myIssuesEmptyMessage" : {
      "comment" : "Mac, My Issues: message under the title of the empty list. 'On a board or not' means whether or not the issue is on a GitHub project board. Also: iPhone and iPad, My Issues: explanation under 'Nothing assigned to you'. 'Board' is a GitHub project.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
