    "signOutEverywhereExplanation" : {
      "comment" : "iPhone and iPad, account sheet: message of the question after tapping Sign Out.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du dich überall abmeldest, werden deine Anmeldedaten aus dem iCloud-Schlüsselbund entfernt, und dein Mac, iPhone und iPad melden sich ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signing out everywhere removes your login from iCloud Keychain, so your Mac, iPhone and iPad all sign out."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al cerrar sesión en todas partes, tu inicio de sesión se elimina del Llavero de iCloud y se cierra la sesión en tu Mac, iPhone y iPad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se déconnecter partout supprime vos identifiants du trousseau iCloud : votre Mac, votre iPhone et votre iPad sont tous déconnectés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのデバイスでサインアウトすると、iCloudキーチェーンからログイン情報が削除され、Mac、iPhone、iPadのすべてでサインアウトされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 기기에서 로그아웃하면 iCloud 키체인에서 로그인 정보가 제거되므로 Mac, iPhone, iPad 모두에서 로그아웃됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao encerrar a sessão em todos os dispositivos, seu login é removido das Chaves do iCloud, e o seu Mac, iPhone e iPad encerram a sessão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При выходе на всех устройствах данные для входа удаляются из Связки ключей iCloud, и выход выполняется на Mac, iPhone и iPad."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在所有设备上退出登录会将你的登录信息从 iCloud 钥匙串中移除，你的 Mac、iPhone 和 iPad 都会退出登录。"
          }
        }
      }
    },
