        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » et ses commentaires seront supprimés sur GitHub pour tout le monde. Cette action est irréversible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」とそのコメントは、GitHub上で全員に対して削除されます。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ 이슈와 댓글이 GitHub에서 삭제되어 모든 사용자에게서 사라집니다. 이 동작은 실행 취소할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” e seus comentários serão apagados do GitHub para todos. Essa ação não pode ser desfeita."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задача «%@» и ее комментарии будут удалены на GitHub для всех. Это действие нельзя отменить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
