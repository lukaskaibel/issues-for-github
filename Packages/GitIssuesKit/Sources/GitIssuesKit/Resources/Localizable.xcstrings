            "state" : "translated",
            "value" : "截止日期… 试试“周五”或“10月12日”"
          }
        }
      }
    },
    "dueDateSearchExamples" : {
      "comment" : "iPhone and iPad, due date sheet: hint under 'No date matches …', listing what can be typed. The examples are things the date field understands; it reads English and the app's language, so use this language's own words for them (see the words for dates in Model/CalendarDay.swift, e.g. German 'morgen', 'fr', 'nächste Woche', 'in 3 Tagen', '12.10.'). Keep the date '12.10.' or write it as people in this language type a date.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try “tomorrow”, “fri”, “next week”, “in 3 days” or “12.10.”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prueba “mañana”, “vie”, “próxima semana”, “en 3 días” o “12/10”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「明日」「金」「来週」「3日後」「10月12日」などと入力してみてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
