    "signOutEverywhereExplanation" : {
      "comment" : "iPhone and iPad, account sheet: message of the question after tapping Sign Out.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signing out everywhere removes your login from iCloud Keychain, so your Mac, iPhone and iPad all sign out."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al cerrar sesión en todas partes, tu inicio de sesión se elimina del Llavero de iCloud y se cierra la sesión en tu Mac, iPhone y iPad."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのデバイスでサインアウトすると、iCloudキーチェーンからログイン情報が削除され、Mac、iPhone、iPadのすべてでサインアウトされます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao encerrar a sessão em todos os dispositivos, seu login é removido das Chaves do iCloud, e o seu Mac, iPhone e iPad encerram a sessão."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
