    "signOutDeletesUnsentChanges" : {
      "comment" : "Mac, iPhone and iPad: message of the question before signing out while changes made in the app wait to be sent to GitHub (offline, or GitHub not reached yet). %(count)lld is how many (1, 2, …).",
