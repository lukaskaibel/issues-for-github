        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "진행 중인 작업이 먼저 오고, 그다음 할 일, 백로그, 완료된 작업 순입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primeiro o que está em andamento, depois o que vem a seguir, o backlog e o que está concluído."
          }
        },
        "ru" : {
