            "value" : "You're offline"
          }
        }
      }
    },
    "inboxSomeone" : {
      "comment" : "Mac, Inbox: in the list of what happened on an issue, stands for a person GitHub doesn't name, at the start of a line such as 'Someone commented' (the rest of the line is translated separately).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Someone"
          }
        }
      }
    },
    "inboxTokenCantReadMessage" : {
      "comment" : "Mac, Inbox: explanation under 'Your token can't read notifications'. 'Fine-grained' and 'classic' are GitHub's names for its two kinds of personal access token (use GitHub's terms in your language if it has them); 'repo' is the name of a GitHub permission (scope) and stays as it is.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub doesn't let fine-grained tokens read them. Sign in with GitHub, or use a classic token with the repo scope. Everything else keeps working."
          }
        }
      }
    },
    "inboxTokenCantReadTitle" : {
      "comment" : "Mac, Inbox: title of the message shown instead of the notifications when the user signed in with a GitHub personal access token that isn't allowed to read notifications.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your token can't read notifications"
          }
        }
      }
    },
    "issueRowSpokenWithDue" : {
      "comment" : "Mac, issue list: what VoiceOver reads for a row of an issue that has a due date. %(number)@ is the issue's number such as '#12', %(title)@ its title, %(due)@ when it is due, such as 'Due Friday, 9 October'.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%(number)@ %(title)@, %(due)@"
          }
        }
