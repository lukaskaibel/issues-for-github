    "snoozedBackAtTime" : {
      "comment" : "Inbox: message under 'Snoozed …' when the notification comes back later today. %(time)@ is a time of day, e.g. '18:00' or '6:00 PM'.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
