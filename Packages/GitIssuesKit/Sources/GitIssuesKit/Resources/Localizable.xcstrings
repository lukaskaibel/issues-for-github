    "displayStaysYoursHint" : {
      "comment" : "Display options, under 'Save for Everyone': these choices can't be saved to an existing view on GitHub.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spalten, Gruppierung und Reihenfolge bleiben deine: GitHub legt sie nur beim Erstellen einer Ansicht fest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Columns, grouping and order stay yours: GitHub sets them only when a view is created."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las columnas, la agrupación y el orden son solo tuyos: GitHub los fija solo al crear una vista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
