    "noticeChangeNotSaved" : {
      "comment" : "Notice (Mac: in the bottom corner of the window; iPhone, iPad: banner at the top) title: GitHub refused one of the user's changes. %(number)@ is the issue's number, e.g. '#12', or 'New' for an issue not yet on GitHub.",
