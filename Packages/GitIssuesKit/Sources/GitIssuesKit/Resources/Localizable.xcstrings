    "classicTokenScopes" : {
      "comment" : "iPhone and iPad, token sign-in sheet: note under the token field. 'Classic token' and 'scopes' are GitHub's terms; keep repo, project, read:org and api.github.com as they are.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Token (classic) mit den Scopes repo, project und read:org. Es wird im iCloud-Schlüsselbund gespeichert und nur an api.github.com gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A classic token with the repo, project and read:org scopes. It is kept in iCloud Keychain and only sent to api.github.com."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un token clásico (classic) con los ámbitos repo, project y read:org. Se guarda en el Llavero de iCloud y solo se envía a api.github.com."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un jeton classique avec les scopes repo, project et read:org. Il est conservé dans le trousseau iCloud et envoyé uniquement à api.github.com."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "repo、project、read:orgスコープを持つclassicトークンです。iCloudキーチェーンに保存され、api.github.comにのみ送信されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "repo, project, read:org 범위가 있는 클래식 토큰을 사용합니다. 토큰은 iCloud 키체인에 보관되며 api.github.com으로만 전송됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um token clássico (classic) com os escopos repo, project e read:org. Ele fica nas Chaves do iCloud e só é enviado para api.github.com."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Классический токен (classic) с областями repo, project и read:org. Он хранится в Связке ключей iCloud и отправляется только на api.github.com."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
