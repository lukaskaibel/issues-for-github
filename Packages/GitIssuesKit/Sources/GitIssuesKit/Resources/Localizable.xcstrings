          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open issues assigned to you show up here, on a board or not."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí aparecen las incidencias abiertas que tienes asignadas, estén o no en un tablero."
