    "inboxTokenCantReadMessage" : {
      "comment" : "Mac, Inbox: explanation under 'Your token can't read notifications'. 'Fine-grained' and 'classic' are GitHub's names for its two kinds of personal access token (use GitHub's terms in your language if it has them); 'repo' is the name of a GitHub permission (scope) and stays as it is. Also: iPhone and iPad Inbox: explanation under 'Your token can't read notifications'. 'Fine-grained token', 'classic token' and 'scope' are GitHub's terms; keep 'repo' as it is.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub doesn't let fine-grained tokens read them. Sign in with GitHub, or use a classic token with the repo scope. Everything else keeps working."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub no permite que los tokens detallados (fine-grained) las lean. Inicia sesión con GitHub o usa un token clásico (classic) con el ámbito repo. Todo lo demás sigue funcionando."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHubでは、fine-grainedトークンで通知を読み取ることはできません。GitHubでサインインするか、repoスコープを持つclassicトークンを使用してください。その他の機能はそのまま使えます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O GitHub não permite que tokens fine-grained leiam notificações. Inicie sessão com o GitHub ou use um token clássico (classic) com o escopo repo. Todo o resto continua funcionando."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub 不允许细粒度（fine-grained）令牌读取通知。请使用 GitHub 登录，或使用具有 repo 作用域的经典（classic）令牌。其他功能均可正常使用。"
          }
        }
      }
    },
    "inboxTokenCantReadTitle" : {
      "comment" : "Mac, Inbox: title of the message shown instead of the notifications when the user signed in with a GitHub personal access token that isn't allowed to read notifications. Also: iPhone and iPad Inbox: title when the user signed in with a token that GitHub doesn't let read notifications.",
