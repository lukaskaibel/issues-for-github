    "errorRateLimited" : {
      "comment" : "Error message shown when syncing or signing in fails (sync status, sign-in screen, warning notices, list of changes waiting to be sent). GitHub allows only so many requests per hour; the app waits and then carries on by itself.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Rate-Limit von GitHub ist erreicht. Die Synchronisierung geht gleich weiter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub's rate limit was reached. Syncing resumes shortly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se alcanzó el límite de solicitudes de GitHub. La sincronización se reanudará en breve."
