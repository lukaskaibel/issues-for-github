        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prueba “mañana”, “vie”, “próxima semana”, “en 3 días” o “12/10”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essayez « demain », « ven », « semaine prochaine », « dans 3 jours » ou « 12/10 »."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「明日」「金」「来週」「3日後」「10月12日」などと入力してみてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“내일”, “금”, “다음 주”, “3일 후” 또는 “10월 12일”을 입력해 보세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tente “amanhã”, “sex”, “próxima semana”, “em 3 dias” ou “12/10”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попробуйте «завтра», «пт», «следующая неделя», «через 3 дня» или «12.10.»."
