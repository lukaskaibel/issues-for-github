    "conflictDescriptionEditedOnGitHub" : {
      "comment" : "Mac, issue view and Inbox: warning banner when the issue's description (the text under its title) was changed on GitHub while the user's own change of it was waiting to be sent. Buttons under it keep the user's version or take GitHub's.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The description was also edited on GitHub. Nothing has been overwritten: your version is shown below and has not been sent."
          }
        }
      }
    },
    "conflictGitHubVersion" : {
      "comment" : "Mac, issue view, conflict warning banner: small heading above the text as it is now on GitHub (the other version of the title or description).",
