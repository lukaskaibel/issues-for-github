    "projectHasNoRepository" : {
      "comment" : "iPhone and iPad, new issue sheet: warning when the chosen GitHub project has no repository linked to it, so no issue can be created in it yet.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Projekt hat noch kein Repository. Issues werden in einem Repository erstellt, das mit dem Projekt verknüpft ist – verknüpfe zuerst eins auf GitHub."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This project has no repository yet. Issues are created in a repository linked to the project; link one on GitHub first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este proyecto aún no tiene ningún repositorio. Las incidencias se crean en un repositorio vinculado al proyecto; vincula uno primero en GitHub."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce projet n’a pas encore de dépôt. Les tickets sont créés dans un dépôt lié au projet ; liez-en un sur GitHub d’abord."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロジェクトにはまだリポジトリがありません。Issueはプロジェクトにリンクされたリポジトリに作成されます。先にGitHubでリポジトリをリンクしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 프로젝트에는 아직 저장소가 없습니다. 이슈는 프로젝트에 연결된 저장소에 생성되므로 먼저 GitHub에서 저장소를 연결하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este projeto ainda não tem um repositório. As issues são criadas em um repositório vinculado ao projeto; vincule um no GitHub primeiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У этого проекта еще нет репозитория. Задачи создаются в репозитории, связанном с проектом, — сначала свяжите его на GitHub."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此项目还没有仓库。议题会创建在与项目关联的仓库中；请先在 GitHub 上关联一个仓库。"
          }
        }
      }
    },
