          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 하위 이슈가 완료되면 상위 이슈도 완료로 표시"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
