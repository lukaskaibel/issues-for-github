    "dueDatePlaceholder" : {
      "comment" : "Mac: placeholder in the search field of the due date picker. The quoted examples are things the field understands; it reads English and the app's language, so use this language's own words (see DateWords in Model/CalendarDay.swift), e.g. German „fr“ or „12.10.“.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fällig am … z. B. „fr“ oder „12.10.“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Due date… try “fri” or “12.10.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fecha de vencimiento… prueba “vie” o “12/10”"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échéance… essayez « ven » ou « 12/10 »"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "期日…「金」や「10月12日」など"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마감일… 예: “금” 또는 “10월 12일”"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prazo… tente “sex” ou “12/10”"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Срок… например, «пт» или «12.10.»"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "截止日期… 试试“周五”或“10月12日”"
          }
        }
      }
    },
    "dueDateSearchExamples" : {
      "comment" : "iPhone and iPad, due date sheet: hint under 'No date matches …', listing what can be typed. The examples are things the date field understands; it reads English and the app's language, so use this language's own words for them (see the words for dates in Model/CalendarDay.swift, e.g. German 'morgen', 'fr', 'nächste Woche', 'in 3 Tagen', '12.10.'). Keep the date '12.10.' or write it as people in this language type a date.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versuch es mit „morgen“, „fr“, „nächste Woche“, „in 3 Tagen“ oder „12.10.“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try “tomorrow”, “fri”, “next week”, “in 3 days” or “12.10.”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prueba “mañana”, “vie”, “próxima semana”, “en 3 días” o “12/10”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essayez « demain », « ven », « semaine prochaine », « dans 3 jours » ou « 12/10 »."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「明日」「金」「来週」「3日後」「10月12日」などと入力してみてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“내일”, “금”, “다음 주”, “3일 후” 또는 “10월 12일”을 입력해 보세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tente “amanhã”, “sex”, “próxima semana”, “em 3 dias” ou “12/10”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попробуйте «завтра», «пт», «следующая неделя», «через 3 дня» или «12.10.»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "试试“明天”“周五”“下周”“3 天后”或“10月12日”。"
          }
        }
      }
    },
