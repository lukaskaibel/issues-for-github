    "archivedNotifications" : {
      "comment" : "Inbox (Mac, iPhone, iPad): short notice with an Undo button after several GitHub notifications were archived (verb, past tense). %(count)lld is 2 or more.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
