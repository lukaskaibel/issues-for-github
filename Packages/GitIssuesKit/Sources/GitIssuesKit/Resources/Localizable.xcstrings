    "allCaughtUpMessage" : {
      "comment" : "iPhone and iPad Inbox: explanation under 'You're all caught up'. Also: Mac, Inbox: under 'You're all caught up', saying what the Inbox shows.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn dir jemand etwas zuweist, dich erwähnt oder ein Issue kommentiert, dem du folgst, erscheint es hier."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When someone assigns you, mentions you or comments on an issue you follow, it shows up here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando alguien te asigne, te mencione o comente en una incidencia que sigues, aparecerá aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand quelqu’un vous assigne un ticket, vous mentionne ou commente un ticket que vous suivez, cela s’affiche ici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "担当者に割り当てられたり、メンションされたり、フォロー中のIssueにコメントが付いたりすると、ここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "누군가 나에게 이슈를 할당하거나 나를 멘션하거나, 내가 구독 중인 이슈에 댓글을 달면 여기에 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando alguém atribuir algo a você, mencionar você ou comentar em uma issue que você acompanha, isso aparece aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда вас назначат исполнителем, упомянут или прокомментируют задачу, за которой вы следите, уведомление появится здесь."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当有人将议题分配给你、提及你或评论你关注的议题时，通知会显示在这里。"
          }
        }
      }
    },
