    "completeParentFooter" : {
      "comment" : "Settings (Mac, iPhone, iPad), under the Sub-issues section: explains the switch above it. 'Done' is the board column of finished issues.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erledigst du das letzte offene Sub-Issue eines Issues, wird auch das übergeordnete Issue erledigt, auf jedem Board, auf dem es liegt. Änderungen auf GitHub lösen das nicht aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finish the last open sub-issue of an issue, and the parent issue moves to Done as well, on every board it's on. Changes made on GitHub don't do this."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al completar la última subincidencia abierta de una incidencia, la incidencia principal también se completa, en cada tablero donde esté. Los cambios hechos en GitHub no lo hacen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque vous terminez le dernier sous-ticket ouvert d’un ticket, le ticket parent est aussi terminé, sur chaque tableau où il figure. Les modifications faites sur GitHub ne le déclenchent pas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最後に残ったオープンのサブIssueを完了すると、親Issueも、追加されているすべてのボードで完了になります。GitHub上での変更では、この動作は行われません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이슈의 마지막 열린 하위 이슈를 완료하면 상위 이슈도 해당 이슈가 있는 모든 보드에서 완료됩니다. GitHub에서 변경한 경우에는 적용되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao concluir a última sub-issue aberta de uma issue, a issue principal também é concluída, em cada quadro em que estiver. Alterações feitas no GitHub não fazem isso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда вы выполняете последнюю открытую подзадачу, родительская задача тоже становится выполненной — на каждой доске, где она есть. Изменения на GitHub этого не делают."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完成某个议题的最后一个未完成子议题后，父议题也会在它所在的每个看板上标记为完成。在 GitHub 上所做的更改不会触发此操作。"
          }
        }
      }
    },
    "completeParentSetting" : {
      "comment" : "Settings (Mac, iPhone, iPad), Sub-issues section: switch. When on, finishing the last open sub-issue of an issue moves that parent issue to Done too, as Linear can.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
