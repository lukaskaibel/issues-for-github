    "shareLoginMessage" : {
      "comment" : "Mac: message of the alert offering to share the login with the iPhone and iPad. 'GitHub CLI' is GitHub's command-line tool.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your GitHub CLI login can be kept in iCloud Keychain, so the app on your iPhone and iPad signs in by itself. You can change this later in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu inicio de sesión de GitHub CLI puede guardarse en el Llavero de iCloud para que la app de tu iPhone y iPad inicie sesión sola. Puedes cambiarlo más tarde en Ajustes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub CLIのログイン情報をiCloudキーチェーンに保存すると、iPhoneとiPadのAppが自動的にサインインします。この設定はあとから「設定」で変更できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu login da GitHub CLI pode ficar nas Chaves do iCloud para que o app no seu iPhone e iPad inicie sessão sozinho. Você pode mudar isso depois nos Ajustes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 GitHub CLI 登录信息可以保存在 iCloud 钥匙串中，这样你 iPhone 和 iPad 上的 App 就能自动登录。你稍后可以在“设置”中更改。"
          }
        }
      }
    },
