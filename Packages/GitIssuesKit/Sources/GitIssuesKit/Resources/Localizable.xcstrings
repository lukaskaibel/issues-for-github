    "conflictDescriptionEditedOnGitHub" : {
      "comment" : "iPhone and iPad, issue screen: warning banner after the user changed the issue's description while someone else changed it on GitHub. The user's version is in the description below the banner; GitHub's is shown in the banner.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The description was also edited on GitHub. Nothing has been overwritten: your version is shown below and has not been sent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La descripción también se editó en GitHub. No se ha sobrescrito nada: tu versión se muestra abajo y no se ha enviado."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "説明はGitHubでも編集されています。何も上書きされていません。あなたのバージョンは下に表示されており、まだ送信されていません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A descrição também foi editada no GitHub. Nada foi sobrescrito: sua versão aparece abaixo e não foi enviada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "描述也在 GitHub 上被编辑过。没有任何内容被覆盖：你的版本显示在下方，尚未发送。"
          }
        }
      }
    },
