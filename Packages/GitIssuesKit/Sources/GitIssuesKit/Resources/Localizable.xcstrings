          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Due date… try “fri” or “12.10.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fecha de vencimiento… prueba “vie” o “12/10”"
          }
        },
