    "remindersFooterIPad" : {
      "comment" : "iPad settings, under the Reminders section: the reminders are scheduled by the device itself, no server is involved.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das iPad erinnert dich selbst – anhand der Fälligkeitsdaten auf GitHub. Dafür wird nichts irgendwohin gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The iPad reminds you itself, from the due dates on GitHub. Nothing is sent anywhere for it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El iPad te avisa por sí mismo a partir de las fechas de vencimiento de GitHub. Para ello no se envía nada a ninguna parte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’iPad vous rappelle lui-même les échéances fixées sur GitHub. Rien n’est envoyé nulle part pour cela."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad自体が、GitHubの期日をもとにリマインダーを通知します。そのためにデータが外部に送信されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad가 GitHub의 마감일을 바탕으로 직접 알려 줍니다. 이를 위해 외부로 전송되는 정보는 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O próprio iPad lembra você, a partir dos prazos no GitHub. Nada é enviado a lugar nenhum para isso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad сам напоминает вам о сроках из GitHub. Для этого никуда ничего не отправляется."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad 会根据 GitHub 上的截止日期自行提醒你，不会为此向任何地方发送数据。"
          }
        }
      }
    },
