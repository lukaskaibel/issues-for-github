    "changesSavedOnIPad" : {
      "comment" : "iPad, account sheet: note under the Sync section.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Änderungen werden zuerst auf diesem iPad gespeichert und im Hintergrund an GitHub gesendet. Was du offline änderst, wird gesendet, sobald du wieder online bist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changes are saved on this iPad first and sent to GitHub in the background. Offline changes go out when you're back online."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cambios se guardan primero en este iPad y se envían a GitHub en segundo plano. Los que hagas sin conexión se enviarán cuando vuelvas a estar en línea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modifications sont d’abord enregistrées sur cet iPad, puis envoyées à GitHub en arrière-plan. Celles faites hors ligne partent dès que vous êtes de nouveau en ligne."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変更はまずこのiPadに保存され、バックグラウンドでGitHubに送信されます。オフライン中の変更は、オンラインに戻ったときに送信されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "변경 사항은 먼저 이 iPad에 저장되고 백그라운드에서 GitHub로 전송됩니다. 오프라인 상태에서 변경한 내용은 다시 온라인 상태가 되면 전송됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As alterações são salvas primeiro neste iPad e enviadas ao GitHub em segundo plano. O que você alterar offline é enviado quando você voltar a ficar online."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изменения сначала сохраняются на этом iPad и в фоновом режиме отправляются на GitHub. Изменения, сделанные без сети, отправятся, когда подключение восстановится."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改会先保存在这台 iPad 上，然后在后台发送到 GitHub。离线时所做的更改会在你恢复联网后发送。"
          }
        }
      }
    },
