    "appVersionLoginNote" : {
      "comment" : "iPhone and iPad, account sheet: the app's name and version at the bottom, with a note on privacy. 'Issues' is the app's name; %(version)@ is its version, e.g. '1.2'. Keep api.github.com as it is.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Issues %@ · Deine Anmeldedaten werden im iCloud-Schlüsselbund gespeichert und nur an api.github.com gesendet."
          }
        },
        "en" : {
