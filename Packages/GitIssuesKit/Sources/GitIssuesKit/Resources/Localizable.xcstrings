        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHubのレート制限に達しました。まもなく同期が再開されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub 요청 한도에 도달했습니다. 잠시 후 동기화가 다시 시작됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O limite de solicitações do GitHub foi atingido. A sincronização será retomada em breve."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Достигнут лимит запросов к GitHub. Синхронизация скоро продолжится."
