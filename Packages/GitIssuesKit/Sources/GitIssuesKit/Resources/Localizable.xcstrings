    "projectGoneMessage" : {
      "comment" : "iPhone and iPad: explanation under 'This project is gone'.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wurde geschlossen oder gelöscht, oder du hast auf GitHub keinen Zugriff mehr darauf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It was closed, deleted, or you no longer have access to it on GitHub."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se cerró, se eliminó o ya no tienes acceso a él en GitHub."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il a été fermé ou supprimé, ou vous n’y avez plus accès sur GitHub."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHubでクローズまたは削除されたか、アクセス権がなくなりました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub에서 닫혔거나 삭제되었거나, 더 이상 접근 권한이 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele foi fechado ou apagado, ou você não tem mais acesso a ele no GitHub."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Его закрыли, удалили или у вас больше нет к нему доступа на GitHub."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它已被关闭或删除，或者你已无法在 GitHub 上访问它。"
          }
        }
      }
    },
