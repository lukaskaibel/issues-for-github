    "addToNamedProject" : {
      "comment" : "iPhone and iPad: submenu (a verb) of an issue that is on none of the user's boards, listing the columns of the GitHub project it can go on; also the heading of those columns. %(project)@ is the project's name, such as “Roadmap”.",
