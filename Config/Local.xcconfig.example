// Copy this file to Local.xcconfig (same folder) and fill in your Apple Developer team to sign
// builds with your own certificate. Local.xcconfig is ignored by git.

DEVELOPMENT_TEAM = YOUR_TEAM_ID
CODE_SIGN_IDENTITY = Apple Development

// With a team, the Mac shares its GitHub login with the iPhone and iPad through iCloud Keychain.
GI_MAC_ENTITLEMENTS = Config/GitIssues-macOS.entitlements

// Client ID of your GitHub OAuth app (device flow enabled), for "Sign in with GitHub".
// GITHUB_CLIENT_ID = Iv1.0123456789abcdef

// Use your own identifier if you want your build to keep its data separate from an official one.
// PRODUCT_BUNDLE_IDENTIFIER = com.example.GitIssues
