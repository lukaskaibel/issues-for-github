# Copy to fastlane/.env.secret and fill in. That file is gitignored; never commit it.

# App Store Connect API key: App Store Connect › Users and Access › Integrations › App Store Connect API.
# A team key with the App Manager or Admin role, and access to certificates, identifiers and profiles,
# so Xcode can sign the builds with it.
APP_STORE_CONNECT_API_KEY_P8_PATH=/absolute/path/to/AuthKey_XXXXXXXXXX.p8
APP_STORE_CONNECT_API_KEY_KEY_ID=XXXXXXXXXX
APP_STORE_CONNECT_API_KEY_ISSUER_ID=00000000-0000-0000-0000-000000000000

# Who App Review contacts with questions. Kept here because the repository is public.
REVIEW_FIRST_NAME=
REVIEW_LAST_NAME=
REVIEW_PHONE=+49 000 0000000
REVIEW_EMAIL=

# Optional: a GitHub account for App Review, as its login and a personal access token for it.
# Without one, App Review uses "Explore with Sample Data".
REVIEW_DEMO_USER=
REVIEW_DEMO_PASSWORD=
