# Releases Issues to the App Store and TestFlight, for the Mac, iPhone and iPad.
#
# Every call to App Store Connect signs in with an App Store Connect API key (.p8), so there are no Apple ID or
# two-factor prompts; store_signing below says how the builds are signed. Copy fastlane/.env.secret.example to
# fastlane/.env.secret (it is gitignored) and fill it in, run `bundle install` once, and then:
#
#   bundle exec fastlane screenshots   # take the App Store screenshots of the iPhone, iPad and Mac apps
#   bundle exec fastlane metadata      # upload the texts, the age rating and the screenshots of both platforms
#   bundle exec fastlane build         # build the Mac, iPhone and iPad apps for the App Store, without uploading
#   bundle exec fastlane beta          # build the Mac, iPhone and iPad apps and upload them to TestFlight
#   bundle exec fastlane release       # build them, upload everything and submit both platforms for review
#
# `bundle exec fastlane ios <lane>` and `bundle exec fastlane mac <lane>` do one platform. The texts are in
# fastlane/metadata and the screenshots in Design/screenshots/app-store. Design/app-store.md lists what has to be set
# once in App Store Connect itself.

require "fileutils"
require "plist"
require "shellwords"

# The texts and build settings are UTF-8 ("›", "•", "⌘"), whatever the shell's locale is.
Encoding.default_external = Encoding::UTF_8
ENV["LANG"] = "en_US.UTF-8" if ENV["LANG"].to_s.empty?
ENV["LC_ALL"] = "en_US.UTF-8" if ENV["LC_ALL"].to_s.empty?

APP_ID = "com.lukaskbl.GitIssues"
# Absolute paths, taken while loading: lanes run from other folders, and __dir__ is relative in a Fastfile.
HERE = File.expand_path(__dir__)
ROOT = File.expand_path("..", HERE)
PROJECT = File.join(ROOT, "GitIssues.xcodeproj")
SCHEME = "GitIssues"
METADATA = File.join(HERE, "metadata")
SCREENSHOTS = File.join(ROOT, "Design", "screenshots", "app-store")
OUTPUT = File.join(ROOT, "build", "fastlane")

# One app on two App Store platforms: how each is built and which screenshots belong to it.
PLATFORMS = {
  ios: { name: "iPhone and iPad", configuration: "Release", sdk: "iphoneos", destination: "generic/platform=iOS", store: "ios",
         package: :ipa, screenshots: %w[iphone ipad], screenshot_tool: "app-store-screenshots.sh" },
  mac: { name: "Mac", configuration: "AppStore", sdk: "macosx", destination: "generic/platform=macOS", store: "osx",
         package: :pkg, screenshots: %w[mac], screenshot_tool: "mac-app-store-screenshots.sh" }
}.freeze

# fastlane/.env.secret holds the API key and the contact for App Review. Values already in the environment win.
secrets = File.join(HERE, ".env.secret")
if File.exist?(secrets)
  File.foreach(secrets) do |line|
    key, value = line.strip.split("=", 2)
    next if key.to_s.empty? || key.start_with?("#") || value.nil?

    ENV[key] ||= value
  end
end

def secret(name)
  value = ENV[name].to_s
  UI.user_error!("#{name} is not set. Copy fastlane/.env.secret.example to fastlane/.env.secret and fill it in.") if value.empty?
  value
end

def flag(value)
  value == true || value.to_s == "true"
end

def api_key
  @api_key ||= app_store_connect_api_key(
    key_id: secret("APP_STORE_CONNECT_API_KEY_KEY_ID"),
    issuer_id: secret("APP_STORE_CONNECT_API_KEY_ISSUER_ID"),
    key_filepath: File.expand_path(secret("APP_STORE_CONNECT_API_KEY_P8_PATH"))
  )
end

# Lets Xcode make the development profiles for the archive, signed in with the same API key.
def signing_arguments
  [
    "-allowProvisioningUpdates",
    "-authenticationKeyPath", File.expand_path(secret("APP_STORE_CONNECT_API_KEY_P8_PATH")),
    "-authenticationKeyID", secret("APP_STORE_CONNECT_API_KEY_KEY_ID"),
    "-authenticationKeyIssuerID", secret("APP_STORE_CONNECT_API_KEY_ISSUER_ID")
  ].shelljoin
end

# The archive is signed for development; the export signs it for the App Store the way match does: with the team's
# Apple Distribution certificate in this Mac's keychain and an App Store profile that fastlane makes or fetches with the
# API key. (The key may not use Apple's cloud-managed certificates, so Xcode can't do this part by itself.) The Mac's
# .pkg is signed with a Mac Installer Distribution certificate, which fastlane creates the first time; macOS then asks
# once whether xcodebuild may use its key. Returns the export options.
def store_signing(platform, team)
  folder = File.join(OUTPUT, "signing")
  register_this_mac if platform == :mac
  # get_provisioning_profile would sign the profile with whatever certificate get_certificates handled last.
  lane_context.delete(SharedValues::CERT_CERTIFICATE_ID)
  get_provisioning_profile(api_key: api_key, app_identifier: APP_ID, platform: platform == :mac ? "macos" : "ios",
                           output_path: folder)
  profile = lane_context[SharedValues::SIGH_NAME]
  if platform == :mac
    get_certificates(api_key: api_key, platform: "macos", type: "mac_installer_distribution", output_path: folder)
    lane_context.delete(SharedValues::CERT_CERTIFICATE_ID)
  end
  options = {
    signingStyle: "manual",
    teamID: team,
    signingCertificate: "Apple Distribution",
    provisioningProfiles: { APP_ID => profile },
    manageAppVersionAndBuildNumber: false
  }
  options[:installerSigningCertificate] = "Mac Installer Distribution" if platform == :mac
  options
end

# The Mac's development profile, which the archive is signed with first, has to list this Mac. Building for "My Mac"
# in Xcode registers it with the team; an archive for any Mac doesn't, so this does (once; it's left alone after).
def register_this_mac
  udid = sh("system_profiler SPHardwareDataType", log: false)[/Provisioning UDID: (\S+)/, 1]
  return UI.important("This Mac's provisioning UDID is unknown; the archive may lack a development profile.") if udid.nil?

  register_device(api_key: api_key, platform: "mac", udid: udid, name: sh("scutil --get ComputerName", log: false).strip)
end

# A build setting as Xcode resolves it, Config/Local.xcconfig included.
def build_setting(platform, name)
  @settings ||= {}
  @settings[platform] ||= begin
    config = PLATFORMS.fetch(platform)
    sh(["xcodebuild", "-project", PROJECT, "-scheme", SCHEME, "-configuration", config[:configuration],
        "-destination", config[:destination], "-showBuildSettings"].shelljoin + " 2>/dev/null", log: false)
  end
  @settings[platform][/^\s+#{name} = (.*)$/, 1].to_s.strip
end

def version
  File.read(File.join(ROOT, "Config", "Shared.xcconfig"))[/^MARKETING_VERSION = (.+)$/, 1].strip
end

# Every upload needs a higher build number. It comes from the date and time (2026.1005.2130), as in
# Tools/testflight.sh, and is the same for both platforms of one release.
def build_number
  @build_number ||= begin
    now = Time.now
    "#{now.year}.#{now.month * 100 + now.day}.#{now.hour * 100 + now.min}"
  end
end

# Archives one platform for the App Store and returns the .ipa or .pkg.
def archive_for_store(platform, token_only: false)
  config = PLATFORMS.fetch(platform)
  team = build_setting(platform, "DEVELOPMENT_TEAM")
  UI.user_error!("No team set. Copy Config/Local.xcconfig.example to Config/Local.xcconfig and fill in your team ID.") if team.empty?
  if build_setting(platform, "GITHUB_CLIENT_ID").empty?
    message = "GITHUB_CLIENT_ID is empty in Config/Local.xcconfig, so this build has no \"Sign in with GitHub\"."
    UI.user_error!("#{message} Pass token_only:true to build it anyway.") unless token_only
    UI.important(message)
  end

  folder = File.join(OUTPUT, platform.to_s)
  UI.header("#{config[:name]}: Issues #{version} (#{build_number})")
  export_options = store_signing(platform, team)
  package = build_app(
    project: PROJECT,
    scheme: SCHEME,
    configuration: config[:configuration],
    # The target is for both platforms; the SDK tells gym which package to make (.ipa or .pkg).
    sdk: config[:sdk],
    destination: config[:destination],
    clean: true,
    archive_path: File.join(folder, "Issues.xcarchive"),
    output_directory: folder,
    output_name: "Issues",
    export_method: "app-store",
    export_options: export_options,
    skip_profile_detection: true,
    # gym hands these to the export as well, so the signing arguments mustn't go into export_xcargs a second time.
    xcargs: "#{signing_arguments} CURRENT_PROJECT_VERSION=#{build_number}"
  )
  check_sandbox(File.join(folder, "Issues.xcarchive")) if platform == :mac
  package
end

# The Mac App Store takes only sandboxed apps (Tools/testflight-mac.sh checks the same).
def check_sandbox(archive)
  app = Dir[File.join(archive, "Products", "Applications", "*.app")].first
  entitlements = sh("codesign -d --entitlements - --xml #{app.shellescape} 2>/dev/null", log: false)
  sandboxed = Plist.parse_xml(entitlements)&.fetch("com.apple.security.app-sandbox", false)
  UI.user_error!("The archived Mac app is not sandboxed; not uploading it.") unless sandboxed == true
end

def upload_beta(platform, package)
  config = PLATFORMS.fetch(platform)
  upload_to_testflight(
    api_key: api_key,
    app_platform: config[:store],
    config[:package] => package,
    skip_waiting_for_build_processing: true
  )
end

# deliver wants one folder per language and tells the devices apart by the size of each picture. The prefix keeps
# iPhone and iPad apart and the numbers keep the order.
def stage_screenshots(platform)
  staged = File.join(OUTPUT, "screenshots", platform.to_s)
  FileUtils.rm_rf(staged)
  language = File.join(staged, "en-US")
  FileUtils.mkdir_p(language)
  PLATFORMS.fetch(platform)[:screenshots].each do |device|
    pictures = Dir[File.join(SCREENSHOTS, device, "*.png")].sort
    UI.user_error!("No screenshots in #{File.join(SCREENSHOTS, device)}; run `bundle exec fastlane screenshots`.") if pictures.empty?
    pictures.each { |picture| FileUtils.cp(picture, File.join(language, "#{device}-#{File.basename(picture)}")) }
  end
  staged
end

# The contact for App Review comes from fastlane/.env.secret, since the repository is public. The notes are in
# fastlane/metadata/review_information/notes.txt, which deliver adds by itself.
def review_contact(required: false)
  names = %w[REVIEW_FIRST_NAME REVIEW_LAST_NAME REVIEW_PHONE REVIEW_EMAIL]
  names.each { |name| secret(name) } if required
  {
    first_name: ENV["REVIEW_FIRST_NAME"],
    last_name: ENV["REVIEW_LAST_NAME"],
    phone_number: ENV["REVIEW_PHONE"],
    email_address: ENV["REVIEW_EMAIL"],
    demo_user: ENV["REVIEW_DEMO_USER"],
    demo_password: ENV["REVIEW_DEMO_PASSWORD"]
  }.reject { |_, value| value.to_s.empty? }
end

# Texts, age rating, review notes and screenshots of one platform, with its new build when there is one.
def store_upload(platform, package: nil, submit: false, automatic_release: false)
  config = PLATFORMS.fetch(platform)
  UI.header("#{config[:name]}: App Store #{version}")
  options = {
    api_key: api_key,
    platform: config[:store],
    app_version: version,
    metadata_path: METADATA,
    screenshots_path: stage_screenshots(platform),
    overwrite_screenshots: true,
    app_rating_config_path: File.join(HERE, "rating.json"),
    app_review_information: review_contact(required: submit),
    skip_binary_upload: package.nil?,
    submit_for_review: submit,
    automatic_release: automatic_release,
    # The app uses HTTPS only (ITSAppUsesNonExemptEncryption is NO), and shows the user's own content from GitHub.
    submission_information: {
      export_compliance_uses_encryption: false,
      content_rights_contains_third_party_content: true,
      content_rights_has_rights: true
    },
    force: true,
    run_precheck_before_submit: false,
    precheck_include_in_app_purchases: false
  }
  options[config[:package]] = package if package
  upload_to_app_store(options)
end

def release(platform, options)
  package = archive_for_store(platform, token_only: flag(options[:token_only]))
  store_upload(platform, package: package, submit: options[:submit].nil? || flag(options[:submit]),
                         automatic_release: flag(options[:automatic_release]))
end

desc "Takes the App Store screenshots of the iPhone, iPad and Mac apps on the sample data"
lane :screenshots do
  PLATFORMS.each_value { |config| sh(File.join(ROOT, "Tools", config[:screenshot_tool])) }
end

desc "Uploads the texts, the age rating and the screenshots of the Mac, iPhone and iPad apps"
lane :metadata do
  PLATFORMS.each_key { |platform| store_upload(platform) }
end

desc "Builds the Mac, iPhone and iPad apps for the App Store, signed, without uploading them"
desc "token_only:true builds them without GITHUB_CLIENT_ID"
lane :build do |options|
  PLATFORMS.each_key { |platform| archive_for_store(platform, token_only: flag(options[:token_only])) }
end

desc "Builds the Mac, iPhone and iPad apps and uploads them to TestFlight"
desc "token_only:true builds them without GITHUB_CLIENT_ID"
lane :beta do |options|
  PLATFORMS.each_key { |platform| upload_beta(platform, archive_for_store(platform, token_only: flag(options[:token_only]))) }
end

desc "Builds the Mac, iPhone and iPad apps, uploads them with texts and screenshots and submits them for review"
desc "submit:false stops before the submission, automatic_release:true releases them as soon as they are approved"
lane :release do |options|
  PLATFORMS.each_key { |platform| release(platform, options) }
end

platform :ios do
  desc "Takes the iPhone and iPad screenshots"
  lane(:screenshots) { sh(File.join(ROOT, "Tools", PLATFORMS[:ios][:screenshot_tool])) }

  desc "Uploads the texts, the age rating and the screenshots of the iPhone and iPad app"
  lane(:metadata) { store_upload(:ios) }

  desc "Builds the iPhone and iPad app for the App Store, signed, without uploading it"
  lane(:build) { |options| archive_for_store(:ios, token_only: flag(options[:token_only])) }

  desc "Builds the iPhone and iPad app and uploads it to TestFlight"
  lane(:beta) { |options| upload_beta(:ios, archive_for_store(:ios, token_only: flag(options[:token_only]))) }

  desc "Builds the iPhone and iPad app, uploads it with texts and screenshots and submits it for review"
  lane(:release) { |options| release(:ios, options) }
end

platform :mac do
  desc "Takes the Mac screenshots"
  lane(:screenshots) { sh(File.join(ROOT, "Tools", PLATFORMS[:mac][:screenshot_tool])) }

  desc "Uploads the texts, the age rating and the screenshots of the Mac app"
  lane(:metadata) { store_upload(:mac) }

  desc "Builds the Mac app for the App Store, signed, without uploading it"
  lane(:build) { |options| archive_for_store(:mac, token_only: flag(options[:token_only])) }

  desc "Builds the Mac app and uploads it to TestFlight"
  lane(:beta) { |options| upload_beta(:mac, archive_for_store(:mac, token_only: flag(options[:token_only]))) }

  desc "Builds the Mac app, uploads it with texts and screenshots and submits it for review"
  lane(:release) { |options| release(:mac, options) }
end
